<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>

    <VersionOverride>0</VersionOverride>
    <Version>1.0.$(VersionOverride)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <DebugType>none</DebugType>
    <NativeLib>Shared</NativeLib>
    <!-- .NET 10+ prefixes shared libraries with "lib" outside Windows (libModInstaller.Native.so);
         keep the ModInstaller.Native.so name the binding, prebuilds and tests load. -->
    <UseNativeLibPrefix>false</UseNativeLibPrefix>
    <DefineConstants>$(DefineConstants);LOGGING;</DefineConstants>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <!--
    Default to the host's architecture (x64 or arm64) when no RID is given on the
    command line; `dotnet publish -r <rid>` still overrides this.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <_HostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_HostArch>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' And $(OS) == 'Windows_NT'">
    <RuntimeIdentifier>win-$(_HostArch)</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' And $(OS) != 'Windows_NT'">
    <RuntimeIdentifier>linux-$(_HostArch)</RuntimeIdentifier>
  </PropertyGroup>
  
  <PropertyGroup Condition="$(Configuration) == 'Release'">
    <DefineConstants>$(DefineConstants);TRACK_ALLOCATIONS;</DefineConstants>
  </PropertyGroup>
  
  <PropertyGroup Condition="$(Configuration) == 'Release'">
    <!--
    <DebuggerSupport>false</DebuggerSupport>
    -->
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>

  <ItemGroup>
    <None Update="ModInstaller.Native.h">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModInstaller.Adaptor.Typed\ModInstaller.Adaptor.Typed.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
    <PackageReference Include="BUTR.NativeAOT.Analyzer" Version="1.0.78" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    -->
    <PackageReference Include="BUTR.NativeAOT.Generator" Version="1.0.99" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="BUTR.NativeAOT.Shared.Source" Version="1.0.99" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="ConcurrentHashSet" Version="1.3.0" />
    <PackageReference Include="ZLogger" Version="2.5.10" />
  </ItemGroup>
  
  <Target Name="CopyNativeContent" AfterTargets="Publish">
    <PropertyGroup>
      <NativeOutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\native\</NativeOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <NativeOutputFiles Include="$(NativeOutputDir)**\*.*" />
    </ItemGroup>
    <Message Importance="high" Text="CopyNativeContent: NativeOutputDir=$(NativeOutputDir)" />
    <Message Importance="high" Text="CopyNativeContent: PublishDir=$(PublishDir)" />
    <Message Importance="high" Text="CopyNativeContent: Files=@(NativeOutputFiles)" />
    <Copy SourceFiles="@(NativeOutputFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
